{
  "name": "acme-array",
  "version": "1.0.0",
  "hooks": [
    {
      "hooks": {
        "Stop": [
          { "hooks": [ { "type": "command", "command": "/opt/acme/array-stop.sh" } ] }
        ]
      }
    },
    {
      "Interrupt": [
        { "hooks": [ { "type": "command", "command": "/opt/acme/array-interrupt.sh" } ] }
      ]
    }
  ]
}
